+JxlEncoderStatus JxlEncoderAddExperimentalYUVFrame(
+    JxlEncoder* enc, const JxlExperimentalYUVInput* in) {
+  if (!enc || !in) return JXL_ENC_ERROR;
+  auto bad = [&](const char* message) {
+    return JXL_API_ERROR(enc, JXL_ENC_ERR_API_USAGE, "%s", message);
+  };
+  if (!enc->basic_info_set || !enc->color_encoding_set || enc->frames_closed ||
+      enc->num_queued_frames != 0 || enc->wrote_bytes) {
+    return bad("YUV requires initialized, unused still encoder");
+  }
+  const auto& b = enc->basic_info;
+  if (!b.uses_original_profile || b.bits_per_sample != 8 || b.exponent_bits_per_sample ||
+      b.num_color_channels != 3 || b.num_extra_channels || b.have_animation ||
+      b.have_preview || b.orientation != JXL_ORIENT_IDENTITY ||
+      (b.intensity_target != 0 && b.intensity_target != 255) ||
+      b.min_nits != 0 || b.relative_to_max_display || b.linear_below != 0 ||
+      !enc->metadata.m.color_encoding.IsSRGB()) {
+    return bad("YUV requires original sRGB RGB8 still metadata, no extras");
+  }
+  if (!in->width || !in->height || in->width > 16384 || in->height > 16384 ||
+      uint64_t(in->width)*in->height > 16777216 ||
+      in->width != b.xsize || in->height != b.ysize) return bad("YUV dimension limit/mismatch");
+  if (in->bit_depth != 8 || in->format > 3 || in->matrix != 6 ||
+      in->primaries != 1 || in->transfer != 13 || in->full_range != 1 ||
+      in->centered != 1 || in->origin_x || in->origin_y) {
+    return bad("YUV supports only full-range BT.601/JFIF, centered, 8-bit sRGB");
+  }
+  const size_t cw = in->format == 2 ? in->width : (in->width+1)/2;
+  const size_t ch = in->format == 0 || in->format == 3 ? (in->height+1)/2 : in->height;
+  for (size_t c = 0; c < (in->format == 3 ? 2u : 3u); ++c) {
+    const auto& p = in->planes[c];
+    const size_t w = c ? cw : in->width, h = c ? ch : in->height;
+    const size_t row = w * (c && in->format == 3 ? 2 : 1);
+    if (!p.data || p.width != w || p.height != h || p.stride < row ||
+        p.offset > p.size || row > p.size-p.offset ||
+        (h-1) > (p.size-p.offset-row)/p.stride) return bad("YUV plane dimensions/stride/bounds");
+  }
+  if (in->format == 3 && in->planes[2].size) return bad("NV12 requires exactly two planes");
+  // A padded frame with an unchanged output canvas avoids disagreeing odd-size
+  // Modular JPEG-upsampling interpretations in existing independent decoders.
+  const size_t fw = in->width + (in->format != 2 && (in->width & 1));
+  const size_t fh = in->height + ((in->format == 0 || in->format == 3) && (in->height & 1));
+  if (fw*fh > 16777216) return bad("YUV padded frame dimension limit");
+  jxl::JxlEncoderChunkedFrameAdapter data(fw, fh, 0);
+  data.SetYUV(*in);
+  auto* settings = JxlEncoderFrameSettingsCreate(enc, nullptr);
+  if (!settings) return bad("YUV frame settings allocation failed");
+  settings->values.lossless = true;
+  settings->values.cparams.SetLossless();
+  settings->values.cparams.color_transform = jxl::ColorTransform::kYCbCr;
+  settings->values.cparams.speed_tier = jxl::SpeedTier::kLightning;
+  settings->values.cparams.colorspace = 0;
+  settings->values.cparams.palette_colors = 0;
+  settings->values.cparams.channel_colors_pre_transform_percent = 0;
+  settings->values.cparams.channel_colors_percent = 0;
+  auto status = JxlEncoderAddImageFrameInternal(settings, fw, fh,
+                                              false, std::move(data));
+  if (status == JXL_ENC_SUCCESS) JxlEncoderCloseInput(enc);
+  return status;
+}
