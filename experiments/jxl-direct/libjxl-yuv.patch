+/** EXPERIMENTAL, local proof only; not an upstream-supported API.
+ * Single still frame, lossless Modular YCbCr. Input is copied on success.
+ * Formats: 0=I420, 1=I422, 2=I444, 3=NV12. Plane dimensions are samples
+ * (NV12 UV width is chroma pairs). Byte buffers must remain valid during call.
+ * Only bit_depth=8, matrix=6 (JFIF/BT.601), primaries=1 (BT.709),
+ * transfer=13 (sRGB), full_range=1, centered=1, origin=(0,0).
+ * BasicInfo must describe RGB8, original profile, no extras/animation/caller crop;
+ * SetColorEncoding must explicitly set sRGB. Frame closes input on success.
+ * Odd subsampled axes are edge-padded in the encoded frame; canvas size is unchanged.
+ * JXL lossless here preserves YCbCr samples; decoder chroma interpolation and
+ * the BT.601 inverse matrix are not an invertible RGB8 roundtrip.
+ */
+typedef struct {
+  const uint8_t* data;
+  size_t size, offset, stride, width, height;
+} JxlExperimentalYUVPlane;
+typedef struct {
+  uint32_t width, height, bit_depth, format;
+  uint32_t matrix, primaries, transfer, full_range, centered, origin_x, origin_y;
+  JxlExperimentalYUVPlane planes[3];
+} JxlExperimentalYUVInput;
+JXL_EXPORT JxlEncoderStatus JxlEncoderAddExperimentalYUVFrame(
+    JxlEncoder* enc, const JxlExperimentalYUVInput* input);
