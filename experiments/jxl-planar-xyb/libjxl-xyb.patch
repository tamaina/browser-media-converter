+// Experimental fused SDR kernel. Input samples are gathered scalarly into
+// bounded YUV vector scratch; interpolation, normalization, matrix, sRGB EOTF
+// and XYB all run in SIMD. RGB exists only in vector registers.
+Status ExperimentalYuvToXYB(const JxlExperimentalYuv& in, size_t x0,
+                             size_t y0, float intensity, Image3F* out,
+                             size_t* lane_count) {
+  JXL_ENSURE(in.depth == 8 || in.depth == 10 || in.depth == 12);
+  JXL_ENSURE((in.matrix == 1 || in.matrix == 6) && in.full_range <= 1);
+  JXL_ENSURE((in.sx == 1 || in.sx == 2) && (in.sy == 1 || in.sy == 2));
+  JXL_ENSURE(x0 <= in.width && out->xsize() <= in.width - x0 &&
+             y0 <= in.height && out->ysize() <= in.height - y0);
+  const size_t bytes = in.depth == 8 ? 1 : 2;
+  for (size_t c = 0; c < 3; ++c) {
+    const auto& p = in.planes[c];
+    const size_t w = c == 0 ? in.width : DivCeil(in.width, in.sx);
+    const size_t h = c == 0 ? in.height : DivCeil(in.height, in.sy);
+    JXL_ENSURE(p.data && p.width == w && p.height == h && h > 0 &&
+               w <= p.stride / bytes && p.size >= w * bytes &&
+               h - 1 <= (p.size - w * bytes) / p.stride);
+  }
+  const HWY_FULL(float) d;
+  const size_t N = Lanes(d);
+  if (lane_count) *lane_count = N;
+  HWY_ALIGN float absorb[MaxLanes(d) * 12];
+  ComputePremulAbsorb(intensity, absorb);
+  const auto sample = [&](size_t c, size_t x, size_t y) -> float {
+    const auto& p = in.planes[c];
+    const uint8_t* v = p.data + y * p.stride + x * bytes;
+    return bytes == 1 ? v[0] : (uint32_t(v[0]) | (uint32_t(v[1]) << 8));
+  };
+  const float maximum = (1u << in.depth) - 1;
+  const float scale = 1u << (in.depth - 8);
+  const float center = 1u << (in.depth - 1);
+  const float kr = in.matrix == 1 ? .2126f : .299f;
+  const float kb = in.matrix == 1 ? .0722f : .114f;
+  for (size_t y = 0; y < out->ysize(); ++y) {
+    for (size_t x = 0; x < out->xsize(); x += N) {
+      // Replicate the final valid sample in inactive lanes; never read source
+      // padding or issue a full-vector source read beyond the plane's bound.
+      HWY_ALIGN float yy[MaxLanes(d)];
+      HWY_ALIGN float q[8][MaxLanes(d)];
+      for (size_t i = 0; i < N; ++i) {
+        const size_t px = x0 + std::min(x + i, out->xsize() - 1);
+        const size_t py = y0 + y;
+        yy[i] = sample(0, px, py);
+        const size_t cx = px / in.sx, cy = py / in.sy;
+        const auto& p = in.planes[1];
+        const size_t nx = in.sx == 1 ? cx : (px & 1 ? std::min(cx + 1, p.width - 1) : (cx ? cx - 1 : 0));
+        const size_t ny = in.sy == 1 ? cy : (py & 1 ? std::min(cy + 1, p.height - 1) : (cy ? cy - 1 : 0));
+        for (size_t c = 0; c < 2; ++c) {
+          q[4*c][i] = sample(c+1,cx,cy);
+          q[4*c+1][i] = sample(c+1,nx,cy);
+          q[4*c+2][i] = sample(c+1,cx,ny);
+          q[4*c+3][i] = sample(c+1,nx,ny);
+        }
+      }
+      const auto a = Set(d,in.sx == 1 ? 1.f : .75f);
+      const auto b = Set(d,in.sy == 1 ? 1.f : .75f), one = Set(d, 1.f);
+      const auto chroma = [&](size_t c) {
+        const auto top = Add(Mul(a, Load(d, q[4*c])), Mul(Sub(one,a), Load(d, q[4*c+1])));
+        const auto bot = Add(Mul(a, Load(d, q[4*c+2])), Mul(Sub(one,a), Load(d, q[4*c+3])));
+        return Mul(Sub(Add(Mul(b,top), Mul(Sub(one,b),bot)), Set(d,center)),
+                   Set(d,1.f/(in.full_range ? maximum : 224.f*scale)));
+      };
+      const auto luma = Mul(Sub(Load(d,yy), Set(d,in.full_range ? 0.f : 16.f*scale)),
+                            Set(d,1.f/(in.full_range ? maximum : 219.f*scale)));
+      const auto cb = chroma(0), cr = chroma(1);
+      const auto r = Add(luma, Mul(Set(d,2.f*(1.f-kr)),cr));
+      const auto blue = Add(luma, Mul(Set(d,2.f*(1.f-kb)),cb));
+      const auto g = Mul(Sub(Sub(luma,Mul(Set(d,kr),r)),Mul(Set(d,kb),blue)),
+                         Set(d,1.f/(1.f-kr-kb)));
+      // The existing transfer approximation and opsin kernel are reused.
+      // Final XYB may write padding lanes, which Image3F reserves for SIMD.
+      LinearRGBToXYB(LinearFromSRGB(Min(one, Max(Zero(d), r))), LinearFromSRGB(Min(one, Max(Zero(d), g))),
+                     LinearFromSRGB(Min(one, Max(Zero(d), blue))), absorb,
+                     out->PlaneRow(0,y)+x, out->PlaneRow(1,y)+x,
+                     out->PlaneRow(2,y)+x);
+    }
+  }
+  return true;
+}
