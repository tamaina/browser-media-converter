{
  "name": "browser-mc",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.4.0",
  "scripts": {
    "build": "pnpm -r --sort build:package",
    "typecheck": "pnpm build && pnpm -r --sort typecheck:package",
    "lint": "eslint .",
    "test": "pnpm -r --sort --if-present test:package",
    "test:electron": "pnpm -r --if-present test:electron && pnpm --filter @browser-mc/browser-movie-converter test:hls:electron",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^9.39.1",
    "@misskey-dev/eslint-plugin": "^2.2.1",
    "@types/node": "^24.10.1",
    "electron": "^42.3.0",
    "esbuild": "^0.27.0",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "playwright": "^1.57.0",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0"
  }
}
