{
  "name": "@browser-mc/binary",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "pnpm --filter @browser-mc/binary... build:package",
    "build:package": "tsc -p tsconfig.json",
    "typecheck": "pnpm --filter @browser-mc/binary... typecheck:package",
    "typecheck:package": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && pnpm test:package",
    "test:package": "node --test test/core.test.mjs"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  }
}
