{
  "name": "@browser-mc/libjxl-wasm",
  "version": "0.0.0",
  "private": true,
  "description": "Patched libjxl v0.11.1 (planar XYB input, source-ICC policy) built for native tests and WebAssembly, plus the createEncoder JS API.",
  "type": "module",
  "types": "./src/api.d.ts",
  "exports": {
    ".": {
      "types": "./src/api.d.ts",
      "import": "./src/api.mjs"
    },
    "./codec.mjs": "./build/wasm/codec.mjs"
  },
  "scripts": {
    "test:api": "node --test --test-isolation=none --test-concurrency=1 test/api.test.mjs test/metadata.test.mjs",
    "build:native": "bash scripts/build-native.sh",
    "build:wasm": "bash ../../experiments/jxl-planar-xyb/build-wasm.sh"
  },
  "dependencies": {
    "@browser-mc/exif-transplant": "workspace:^"
  },
  "files": [
    "src",
    "patches",
    "build/wasm/codec.mjs",
    "build/wasm/codec.wasm",
    "README.md"
  ]
}
