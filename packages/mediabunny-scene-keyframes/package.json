{
  "name": "@browser-mc/mediabunny-scene-keyframes",
  "version": "0.2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/tamaina/browser-media-converter",
    "directory": "packages/mediabunny-scene-keyframes"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "pnpm --filter @browser-mc/mediabunny-scene-keyframes... build:package",
    "build:package": "tsc -p tsconfig.json",
    "typecheck": "pnpm --filter @browser-mc/mediabunny-scene-keyframes... typecheck:package",
    "typecheck:package": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && pnpm test:package",
    "test:package": "node test/detection-unit.mjs",
    "test:electron": "pnpm build && env -u ELECTRON_RUN_AS_NODE xvfb-run -a node test/electron-smoke.mjs"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "mediabunny": "^1.62.0"
  },
  "devDependencies": {
    "mediabunny": "1.62.0"
  }
}
