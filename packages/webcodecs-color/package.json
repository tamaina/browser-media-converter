{
  "name": "@browser-avif-lab/webcodecs-color",
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "prebuild": "pnpm --filter @browser-avif-lab/binary build",
    "build": "tsc -p tsconfig.json",
    "pretypecheck": "pnpm --filter @browser-avif-lab/binary build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build",
    "test:electron": "pnpm build && env -u ELECTRON_RUN_AS_NODE xvfb-run -a node test/electron-smoke.mjs"
  },
  "dependencies": {
    "@browser-avif-lab/binary": "workspace:^"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  }
}
