{
  "name": "@browser-mc/browser-image-resizer-ex",
  "version": "0.5.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/tamaina/browser-media-converter",
    "directory": "packages/browser-image-resizer-ex"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "pnpm --filter @browser-mc/browser-image-resizer-ex... build:package",
    "build:package": "tsc -p tsconfig.json",
    "typecheck": "pnpm --filter @browser-mc/browser-image-resizer-ex... typecheck:package",
    "typecheck:package": "tsc -p tsconfig.json --noEmit",
    "test:electron": "pnpm build && env -u ELECTRON_RUN_AS_NODE xvfb-run -a node test/electron-smoke.mjs",
    "test": "pnpm build"
  },
  "dependencies": {
    "@browser-mc/binary": "workspace:^",
    "@browser-mc/exif-transplant": "workspace:^",
    "@browser-mc/media-container": "workspace:^",
    "@browser-mc/webcodecs-avif": "workspace:^",
    "@browser-mc/webcodecs-color": "workspace:^"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  }
}
