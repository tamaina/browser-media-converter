{
  "name": "@browser-mc/exif-transplant",
  "version": "0.0.4",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/tamaina/browser-media-converter",
    "directory": "packages/exif-transplant"
  },
  "exports": {
    "./tiff": { "types": "./dist/tiff.d.ts", "import": "./dist/tiff.js" },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "pnpm --filter @browser-mc/exif-transplant... build:package",
    "build:package": "tsc -p tsconfig.json",
    "typecheck": "pnpm --filter @browser-mc/exif-transplant... typecheck:package",
    "typecheck:package": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && pnpm test:package",
    "test:browser": "pnpm build && node test/browser.mjs",
    "test:package": "node --test test/*.test.mjs && node test/smoke.mjs"
  },
  "dependencies": {
    "@browser-mc/binary": "workspace:^",
    "@browser-mc/media-container": "workspace:^",
    "brotli": "^2.1.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  }
}
