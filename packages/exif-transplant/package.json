{
  "name": "@browser-mc/exif-transplant",
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "prebuild": "pnpm --filter @browser-mc/media-container build",
    "build": "tsc -p tsconfig.json",
    "pretypecheck": "pnpm --filter @browser-mc/media-container build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test test/tiff.test.mjs && node test/smoke.mjs"
  },
  "dependencies": {
    "@browser-mc/binary": "workspace:^",
    "@browser-mc/media-container": "workspace:^"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  }
}
