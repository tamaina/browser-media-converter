{
  "name": "@browser-mc/browser-movie-converter",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "pnpm --filter @browser-mc/browser-movie-converter... build:package",
    "build:package": "tsc -p tsconfig.json",
    "typecheck": "pnpm --filter @browser-mc/browser-movie-converter... typecheck:package",
    "typecheck:package": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build",
    "test:electron": "pnpm build && env -u ELECTRON_RUN_AS_NODE xvfb-run -a node test/electron-smoke.mjs",
    "test:hls:electron": "pnpm build && env -u ELECTRON_RUN_AS_NODE xvfb-run -a node test/hls-electron-smoke.mjs"
  },
  "dependencies": {
    "@browser-mc/mediabunny-scene-keyframes": "workspace:^",
    "@browser-mc/webcodecs-color": "workspace:^",
    "mediabunny": "^1.46.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  }
}
