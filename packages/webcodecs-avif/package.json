{
  "name": "@browser-mc/webcodecs-avif",
  "version": "0.4.2",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/tamaina/browser-media-converter",
    "directory": "packages/webcodecs-avif"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "pnpm --filter @browser-mc/webcodecs-avif... build:package",
    "build:package": "tsc -p tsconfig.json",
    "typecheck": "pnpm --filter @browser-mc/webcodecs-avif... typecheck:package",
    "typecheck:package": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && pnpm test:package",
    "test:package": "node test/encode-jpeg-to-avif.mjs"
  },
  "dependencies": {
    "@browser-mc/binary": "workspace:^",
    "@browser-mc/media-container": "workspace:^",
    "@browser-mc/webcodecs-color": "workspace:^"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  }
}
